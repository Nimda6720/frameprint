{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "frameprint-api",
  "main": "src/index.mjs",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "vars": {
    "ALLOWED_ORIGINS": "https://nimda6720.github.io,http://localhost:5173"
  },
  "ratelimits": [
    { "name": "API_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }
  ]
}
